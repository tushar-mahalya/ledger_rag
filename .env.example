# Demo only. Copy to .env; generate a fresh token, never reuse a committed value.
LEDGER_DEMO_TOKEN=
LEDGER_LOG_LEVEL=INFO
# Production non-secret values are required by deploy/compose.production.yaml.
LEDGER_OIDC_ISSUER=
LEDGER_OIDC_AUDIENCE=
LEDGER_OIDC_JWKS_URL=
LEDGER_PROVIDER=
LEDGER_LLM_BASE_URL=
LEDGER_LLM_MODEL=
LEDGER_EMBEDDING_BASE_URL=
LEDGER_EMBEDDING_MODEL=
LEDGER_EMBEDDING_DIMENSIONS=1536
# Copy the verified Modal ingestion manifest's space ID; empty keeps legacy endpoint identity.
LEDGER_EMBEDDING_SPACE_ID=
# Optional external database and verified ingestion collection.
LEDGER_QDRANT_URL=
LEDGER_QDRANT_COLLECTION=ledger_chunks
# Chunk profile the collection was built with (v1|v2|v3); v3 also needs the summary version.
LEDGER_CHUNK_PROFILE=v1
LEDGER_CHUNK_SUMMARY_VERSION=
# Optional HTTPS TEI /rerank base endpoint; chat only, voice bypasses it.
LEDGER_RERANKER_URL=
LEDGER_RERANKER_TIMEOUT_SECONDS=3
# Query planning (rewrite/analysis/decomposition). false restores single-query retrieval.
LEDGER_PLANNER_ENABLED=true
LEDGER_PLANNER_REWRITE_MODE=llm
LEDGER_PLANNER_MAX_SUBQUERIES=4
# JSON {"TICKER": ["alias", ...]} (build with scripts/build_gazetteer.py); empty uses
# the caller's company:* groups only.
LEDGER_PLANNER_GAZETTEER_PATH=
# Optional Laya decision tier (compute/decisions.py). The key is a Vault-delivered
# secret (LEDGER_DECISION_API_KEY), never set here.
LEDGER_DECISION_BACKEND=heuristic
LEDGER_DECISION_URL=
# Voice gateway (off by default). STT/TTS keys are secrets: deliver via Vault files,
# LEDGER_STT_API_KEY / LEDGER_TTS_API_KEY, never here. HTTPS is required in production.
LEDGER_VOICE_ENABLED=false
LEDGER_STT_BASE_URL=https://api.openai.com/v1
LEDGER_STT_MODEL=whisper-1
LEDGER_STT_LANGUAGE=en
LEDGER_TTS_BASE_URL=https://api.openai.com/v1
LEDGER_TTS_MODEL=gpt-4o-mini-tts
LEDGER_TTS_VOICE=alloy
# pcm = raw 24 kHz s16le (OpenAI/Kokoro); wav = header parsed from the stream.
LEDGER_TTS_FORMAT=pcm
LEDGER_MAX_VOICE_SESSIONS=16
LEDGER_VOICE_MAX_SESSION_SECONDS=900
LEDGER_VAD_SPEECH_RMS=500
LEDGER_VAD_MIN_SPEECH_MS=200
LEDGER_VAD_BARGE_IN_MS=300
LEDGER_VAD_TRAILING_SILENCE_MS=500
LEDGER_VAD_MAX_UTTERANCE_SECONDS=15
# Secret values belong in Vault, not this file or Compose environment.
