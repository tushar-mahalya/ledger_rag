# Non-secret settings for the prod environment. Secrets come from the SOPS store.
# The production runtime (Cloudflare and Modal) is not defined yet; until it is, this
# profile only fixes the safety-relevant defaults that every production run requires.

LEDGER_ENVIRONMENT=production
LEDGER_AUTH_MODE=oidc
LEDGER_LOG_LEVEL=INFO
LEDGER_RETRIEVAL_BACKEND=qdrant
LEDGER_VERIFICATION_MODE=enforce

# Voice channel service (services/voice).
LEDGER_VOICE_ENVIRONMENT=production
LEDGER_VOICE_TTS_MODEL=eleven_flash_v2_5
LEDGER_VOICE_STT_LANGUAGE=en
