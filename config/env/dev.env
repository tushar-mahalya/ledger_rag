# Non-secret settings for the dev environment, loaded by `ledgerctl run --env dev`.
# Secrets come from the SOPS store (config/secrets.toml routes them); never add any here.
# Every LEDGER_* setting is documented in src/ledger_rag/core/config.py.

LEDGER_ENVIRONMENT=development
LEDGER_AUTH_MODE=demo
LEDGER_LOG_LEVEL=INFO

# Hosted LLM through Gemini's OpenAI-compatible endpoint (key: LEDGER_GEMINI_API_KEY).
LEDGER_PROVIDER=openai
LEDGER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LEDGER_LLM_MODEL=gemini-3.8-flash

# Retrieval stays on the fictional seed corpus until the embedding endpoint is deployed
# in the new Modal workspace. Then switch to:
#   LEDGER_RETRIEVAL_BACKEND=qdrant
#   LEDGER_QDRANT_COLLECTION=<verified collection>
#   LEDGER_EMBEDDING_BASE_URL=https://<workspace>--ledger-inference-embed.modal.run/v1
#   LEDGER_EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
#   LEDGER_EMBEDDING_DIMENSIONS=768
LEDGER_RETRIEVAL_BACKEND=memory
LEDGER_SEED_PATH=data/examples.jsonl

# Voice channel service (services/voice, ADR 0006): `ledgerctl run -- uv run --package
# ledger-voice ledger-voice` serves on 127.0.0.1:8090 and calls the engine below.
LEDGER_VOICE_ENGINE_URL=http://127.0.0.1:8080
# Any voice id from your ElevenLabs voice library.
LEDGER_VOICE_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
LEDGER_VOICE_TTS_MODEL=eleven_flash_v2_5
LEDGER_VOICE_STT_LANGUAGE=en
# For real phone calls: the public HTTPS URL Twilio reaches (e.g. a cloudflared tunnel)
# and the E.164 number(s) this service answers.
LEDGER_VOICE_PUBLIC_URL=
LEDGER_VOICE_ALLOWED_NUMBERS=
